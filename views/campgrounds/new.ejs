<% layout('layouts/boilerplate') -%>
    <div class="row">
        <h1 class="text-center">Add New Campground</h1>
        <div class="col-6 offset-3">
            <form action="/campgrounds" method="POST" novalidate class="validated-form" enctype="multipart/form-data">
                <div class="mb-3">
                    <label class="form-label" for="title">Title:</label>
                    <input class="form-control" type="text" id="title" name="campground[title]" required>
                    <div class="valid-feedback">
                        Excellent!
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="location">Location:</label>
                    <input class="form-control" type="text" id="location" name="campground[location]" required>
                    <div class="valid-feedback">
                        Excellent!
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="price">Price:</label>
                    <div class="input-group">
                        <span class="input-group-text" id="price-label">$</span>
                        <input type="number" class="form-control" id="price" name="campground[price]" placeholder="0.00"
                            aria-label="price" aria-describedby="price-label" min="0" required>
                        <div class="valid-feedback">
                            Excellent!
                        </div>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="description">Description:</label>
                    <textarea class="form-control" id="description" name="campground[description]" required></textarea>
                    <div class="valid-feedback">
                        Excellent!
                    </div>
                </div>


                <!-- <input class="form-control" type="file" name="image" id="image"> -->
                <div class="mb-3">
                    <div class="form-file custom-file">
                        <input class="form-control" type="file" id="image" name="image" multiple>
                        <label class="form-file-label" for="image">
                            <span class="form-file-text">Choose image(s)</span>
                            <span class="form-file-button">Browse</span>
                        </label>
                        <div class="valid-feedback">
                            Excellent!
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <button class="btn btn-success" type="submit">Add Campground</button>
                </div>
            </form>
            <br>
            <button class="btn btn-primary" onclick="window.location.href='/campgrounds'">Back to Campgrounds</button>
        </div>
    </div>